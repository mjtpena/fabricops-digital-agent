# Orqentis FabricOps configuration. Copy to .env for local overrides. NEVER put credentials in this file:
# authentication uses Microsoft Entra ID (DefaultAzureCredential / managed identity / workload identity).

# --- Runtime -------------------------------------------------------------------------------------------
ORQENTIS_DEPLOYMENT_ENVIRONMENT=local          # local | dev | test | prod (non-local requires easy_auth)
ORQENTIS_TENANT_ID=tenant-contoso
ORQENTIS_DEFAULT_TIMEZONE=Australia/Sydney      # IANA zone, validated at startup
ORQENTIS_DATA_DIR=var                          # local event store, state, evidence, audit, logs
ORQENTIS_RUNBOOKS_DIR=runbooks
ORQENTIS_FIXTURES_DIR=fixtures
# ORQENTIS_POLICY_PATH=config/policy.yaml      # defaults to the packaged policy (src/orqentis/policies)

# --- Fabric integration --------------------------------------------------------------------------------
ORQENTIS_FABRIC_MODE=mock                      # mock (synthetic estate) | rest (live Fabric, read-only)
ORQENTIS_SCENARIO=schema_drift                 # mock mode: schema_drift | auth_failure | capacity_pressure | unknown_failure
ORQENTIS_CLOCK=scenario                        # scenario (freeze at the scenario's "now") | system
# ORQENTIS_CONTRACTS_PATH=contracts/estate.json  # rest mode: environments, sources, dependencies, data products, SLAs
#                                              # draft: orqentis contracts scaffold; check: orqentis contracts validate
ORQENTIS_FABRIC_API_BASE_URL=https://api.fabric.microsoft.com/v1
ORQENTIS_POWERBI_API_BASE_URL=https://api.powerbi.com/v1.0/myorg
ORQENTIS_AUTH_MODE=default                     # default | managed_identity | workload_identity | service_principal
# ORQENTIS_MANAGED_IDENTITY_CLIENT_ID=
# service_principal mode reads AZURE_CLIENT_ID / AZURE_TENANT_ID and AZURE_CLIENT_SECRET (or
# AZURE_CLIENT_CERTIFICATE_PATH, a PEM file) from the environment or a secret store at runtime -- never commit them.
# It is how a Fabric tenant other than the Azure tenant is reached; in Azure, Bicep injects them from Key Vault.
# ORQENTIS_LLM_AUTH_MODE=managed_identity      # credential for Azure OpenAI when it must differ from auth_mode
# Sovereign clouds (defaults are the public cloud; see docs/development.md and infra/bicep/README.md):
# ORQENTIS_AUTHORITY_HOST=https://login.microsoftonline.us   # Entra authority host (https host only)
# ORQENTIS_FABRIC_SCOPE=https://api.fabric.microsoft.com/.default
# ORQENTIS_POWERBI_SCOPE=https://analysis.windows.net/powerbi/api/.default
ORQENTIS_HTTP_TIMEOUT_SECONDS=30
ORQENTIS_HTTP_MAX_RETRIES=4
# Global budget for Fabric / Power BI calls, shared by every collector, tool and refresh (rest mode).
ORQENTIS_FABRIC_MAX_CONCURRENCY=4              # calls in flight at once
ORQENTIS_FABRIC_RATE_PER_SECOND=5              # steady request rate; a 429 / Retry-After pauses all callers
ORQENTIS_FABRIC_RATE_BURST=10
ORQENTIS_FABRIC_JOB_INSTANCES_MAX_PAGES=10     # page cap per job-instance listing (Fabric documents no result order)

# --- Incremental collection ----------------------------------------------------------------------------
# Each collector reads [watermark - overlap, now]; a collector that never ran (or whose watermark is older than
# the maximum lookback) reads the last COLLECTION_MAX_LOOKBACK_HOURS.
ORQENTIS_COLLECTION_MAX_LOOKBACK_HOURS=168
ORQENTIS_COLLECTION_OVERLAP_MINUTES=15

# --- Autonomous runtime --------------------------------------------------------------------------------
# Unset: on when ORQENTIS_DEPLOYMENT_ENVIRONMENT is dev|test|prod, off for local. Set true/false to force it.
# ORQENTIS_SCHEDULER_ENABLED=false
ORQENTIS_SCHEDULER_TICK_SECONDS=5              # how often the scheduler checks what is due (and renews its lease)
ORQENTIS_SCHEDULER_LEASE_TTL_SECONDS=60        # leader lease (>= 3x the tick); only the holder runs scheduled jobs
# Seconds to wait after start before taking the lease / running a job, so the previous revision can drain during a
# deploy. Unset: 120 for dev|test|prod, 0 for local. Two revisions on one volume are NOT safe until the PostgreSQL
# system of record (WS6): see docs/security.md section 10.
# ORQENTIS_SCHEDULER_STARTUP_DELAY_SECONDS=120
ORQENTIS_SCHEDULER_JOB_TIMEOUT_MINUTES=30      # a scheduled job running longer than this is cancelled
ORQENTIS_SCHEDULER_COLLECT_ENABLED=true        # collect telemetry + run detection
ORQENTIS_SCHEDULER_COLLECT_INTERVAL_MINUTES=5
ORQENTIS_SCHEDULER_AUTO_INVESTIGATE_ENABLED=true   # investigate DETECTED incidents (as background jobs)
ORQENTIS_SCHEDULER_AUTO_INVESTIGATE_INTERVAL_MINUTES=1
ORQENTIS_SCHEDULER_AUTO_INVESTIGATE_BATCH_SIZE=5   # new investigations queued per run
ORQENTIS_SCHEDULER_AUTO_INVESTIGATE_MAX_ATTEMPTS=3   # failed attempts before an incident is left to a human
ORQENTIS_SCHEDULER_SLA_SWEEP_ENABLED=true      # record SLA state changes as SLA_ASSESSED events
ORQENTIS_SCHEDULER_SLA_SWEEP_INTERVAL_MINUTES=15
ORQENTIS_SCHEDULER_CATALOG_REFRESH_ENABLED=true    # reload workspaces/items/dependencies and apply the diff
ORQENTIS_SCHEDULER_CATALOG_REFRESH_INTERVAL_MINUTES=60
ORQENTIS_SCHEDULER_AUDIT_VERIFY_ENABLED=true   # verify the audit hash chain; a failure raises the audit-verification alert
ORQENTIS_SCHEDULER_AUDIT_VERIFY_INTERVAL_MINUTES=60
ORQENTIS_INVESTIGATION_MAX_CONCURRENCY=2       # investigations running at once (others queue)
ORQENTIS_INVESTIGATION_TIMEOUT_SECONDS=600     # an investigation running longer than this fails and can be retried

# --- Startup and readiness -----------------------------------------------------------------------------
# The container is built in the background: /health (liveness) answers at once, /health/ready returns 503 until
# the estate catalog is loaded. A failing build is retried with exponential backoff; the process never exits.
ORQENTIS_STARTUP_GRACE_SECONDS=10              # max wait for the first build attempt before the port opens
ORQENTIS_BUILD_RETRY_INITIAL_SECONDS=2
ORQENTIS_BUILD_RETRY_MAX_SECONDS=60

# --- Investigator agent --------------------------------------------------------------------------------
ORQENTIS_REASONER=rule_based                   # rule_based | agent_framework (Microsoft Agent Framework + LLM)
ORQENTIS_LLM_PROVIDER=azure_openai             # azure_openai | foundry
# ORQENTIS_AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# ORQENTIS_AZURE_OPENAI_DEPLOYMENT=<deployment-name>
# ORQENTIS_AZURE_OPENAI_API_VERSION=
# ORQENTIS_FOUNDRY_PROJECT_ENDPOINT=
# ORQENTIS_FOUNDRY_MODEL=
ORQENTIS_AGENT_MAX_TOOL_CALLS=12
# Estimated model cost for the orqentis.llm.cost metric: USD per million tokens, from the model's price list.
# 0 = not configured (tokens are counted, no cost is emitted).
ORQENTIS_LLM_INPUT_COST_PER_MILLION_TOKENS=0
ORQENTIS_LLM_OUTPUT_COST_PER_MILLION_TOKENS=0

# --- Action / approval boundary ------------------------------------------------------------------------
ORQENTIS_ENABLE_WRITE_ACTIONS=false            # the write capability boundary is closed by default
ORQENTIS_AUTO_REQUEST_APPROVAL=true            # open approval requests for recommended mutations
ORQENTIS_APPROVAL_TTL_MINUTES=240

# --- API -----------------------------------------------------------------------------------------------
ORQENTIS_API_AUTH_MODE=dev_headers             # dev_headers (local only) | easy_auth (Entra ID via Container Apps)
# ORQENTIS_DEV_HEADERS_ALLOW_REMOTE=false      # `orqentis serve` refuses dev_headers on a non-loopback --host unless true
#                                              # (only for a throwaway local container; the image itself defaults to easy_auth)
# ORQENTIS_API_REQUIRE_READ_ROLE=true          # plain reads need a FabricOps role; default: on under easy_auth, off under dev_headers
#                                              # (collect/investigate always need theirs under easy_auth; true also enables them locally)
ORQENTIS_API_MAX_BODY_BYTES=65536              # larger request bodies get 413
ORQENTIS_API_RATE_LIMIT_ENABLED=true           # per principal and replica, in memory
ORQENTIS_API_RATE_LIMIT_MUTATING_PER_MINUTE=30       # mutating calls (429 + Retry-After beyond it)
ORQENTIS_API_RATE_LIMIT_EXPENSIVE_PER_MINUTE=6       # telemetry collection, investigations, audit verification

# --- Notifications and web UI (ADR-0018) ----------------------------------------------------------------
# The origin people open the UI at. Deep links in notifications are built from it; required with a notifier.
# ORQENTIS_PUBLIC_BASE_URL=https://fabricops.example.com
ORQENTIS_NOTIFIER=null                         # null | teams_workflows | webhook (null: nowhere; local, demo and tests)
# Webhook URLs are SECRETS (the Teams URL carries its signature in the query string). In Azure they are Container App
# secrets that reference Key Vault (infra/bicep). Never commit them, never put them in a file that is committed.
# ORQENTIS_NOTIFY_TEAMS_WEBHOOK_URL=           # notifier=teams_workflows: the Workflows "Teams webhook" URL
# ORQENTIS_NOTIFY_WEBHOOK_URL=                 # notifier=webhook: any https endpoint
# ORQENTIS_NOTIFY_WEBHOOK_SIGNING_SECRET=      # notifier=webhook, optional: HMAC-SHA256 key (X-Orqentis-Signature)
# Host patterns a webhook URL may use, comma separated ("hooks.example.com", "*.logic.azure.com"). Empty: the Power
# Platform hosts for teams_workflows, no restriction for webhook. Private, loopback, link-local and metadata addresses
# are refused after DNS resolution in every case, and redirects are never followed.
# ORQENTIS_NOTIFY_ALLOWED_HOSTS=
ORQENTIS_NOTIFY_TIMEOUT_SECONDS=10             # per delivery attempt, including the DNS lookup
ORQENTIS_NOTIFY_MAX_ATTEMPTS=5                 # attempts per notification (retries use exponential back-off with jitter)
ORQENTIS_NOTIFY_BACKOFF_BASE_SECONDS=2
ORQENTIS_NOTIFY_BACKOFF_MAX_SECONDS=60
ORQENTIS_NOTIFY_OUTBOX_SIZE=200                # pending notifications kept; beyond it the oldest is dropped (and audited)
ORQENTIS_UI_ENABLED=true                       # the server-rendered UI under /ui (same guards and services as the API)
# ORQENTIS_UI_SIGN_IN_PATH=/.auth/login/aad    # deep links go through Easy Auth sign-in (set by Bicep when sign-in is on)
# ORQENTIS_UI_CSRF_SECRET=                     # HMAC key of the form tokens; required with several replicas (Key Vault)

# --- Observability -------------------------------------------------------------------------------------
ORQENTIS_LOG_LEVEL=INFO
ORQENTIS_LOG_FORMAT=json                       # json | console
ORQENTIS_OTEL_CONSOLE_EXPORTER=false
# APPLICATIONINSIGHTS_CONNECTION_STRING=       # set from a secret store; enables Azure Monitor export
# Metrics (docs/operations.md) are recorded through OpenTelemetry and exported only where a destination is configured:
# Application Insights (the connection string above, traces and metrics) or the console (ORQENTIS_OTEL_CONSOLE_EXPORTER,
# which prints spans and metrics). Neither is on by default, so `make demo` and the tests export nothing.
# OTEL_METRIC_EXPORT_INTERVAL (milliseconds, default 60000) sets how often metrics are sent.
