# Live sandbox estate configuration (names and ids only; NEVER put a secret here).
# Copy to config.env to override. Every value below is the default the scripts use.
#
# The scripts refuse to create, change or delete a workspace whose name is not one of the four
# below, and refuse to touch a workspace that is not assigned to CAPACITY_ID.

TENANT_ID="4b7e9d9f-8e54-43da-a1dd-2d1cc793721a"

# Sandbox capacity (shared with non-programme workspaces; the scripts only read its state and
# resume/suspend it through capacity.sh, they never create, resize, reassign or delete it).
SUBSCRIPTION_ID="c8ce2a82-b8b8-4b82-b493-1f82ec33b961"
CAPACITY_RG="RG-FABRICDEMO"
CAPACITY_NAME="fabricdemocap2026"
CAPACITY_ID="36283db8-a462-477f-bea2-702c5fe873be"   # Fabric capacity id (not the ARM id)

# The only workspaces the scripts will ever touch.
WS_DEV="FabricOps Sandbox [DEV]"
WS_TEST="FabricOps Sandbox [TEST]"
WS_PROD="FabricOps Sandbox [PROD]"
WS_CONSUMER="FabricOps Sandbox Consumer"

# Fake connection used only by inject/auth-failure.sh. Name must start with fabricops-sandbox-.
CONNECTION_NAME="fabricops-sandbox-fake-source"

# Least-privilege test identity (service principal object id, not the app id). Workspace role
# Viewer is the only role the scripts ever grant it.
TEST_SP_OBJECT_ID="52a58f55-fed4-4d22-a6df-f3bd8a57dc7a"

# Environments whose lakehouse gets the read-only OneLake data access role for the test service
# principal (Read on Tables/customers; no write, no other table, no Files). TEST is the denied control.
ONELAKE_READ_ENVS="DEV"

# Declared SLA deadline (local time in SLA_TIMEZONE) written to the generated contracts file.
SLA_TIMEZONE="Australia/Sydney"
SLA_DEADLINE="23:59:00"
