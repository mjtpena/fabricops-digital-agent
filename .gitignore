# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local runtime data (event store, evidence, audit, reports)
var/

# Local configuration — never commit credentials
.env
.env.*
!.env.example

# Editors / OS
.idea/
.vscode/
.DS_Store

# Live sandbox estate: generated from live ids / local overrides (never commit tenant ids)
scripts/live-estate/contracts.sandbox.json
scripts/live-estate/config.env
scripts/live-estate/*.generated.json

# Offline Bicep snapshots (scripts/bicep-snapshot.sh writes them elsewhere; never commit one)
infra/bicep/**/*.snapshot.json
