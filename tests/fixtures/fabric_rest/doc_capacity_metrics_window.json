    {
      "request": {
        "method": "POST",
        "path": "/v1.0/myorg/groups/00000000-0000-4000-8000-0000000000a1/datasets/00000000-0000-4000-8000-0000000000a2/executeQueries",
        "query": {},
        "json": {
          "queries": [
            {
              "query": "DEFINE\n    MPARAMETER 'CapacitiesList' = { \"00000000-0000-4000-8000-0000000000a0\" }\n    MPARAMETER 'TimePoint' = (DATE(2026, 10, 21) + TIME(12, 11, 30))\nEVALUATE\nTOPN(\n    10,\n    SUMMARIZECOLUMNS(\n        'Items'[Workspace Id],\n        'Items'[Item Id],\n        'Items'[Item name],\n        'Items'[Item kind],\n        TREATAS({\"00000000-0000-4000-8000-0000000000a0\"}, 'Capacities'[capacityId]),\n        TREATAS({(DATE(2026, 10, 21) + TIME(12, 11, 30))}, 'TimePoints'[TimePoint]),\n        \"InteractiveCuPercent\", SUM('Timepoint Interactive Detail'[% of Base Capacity]),\n        \"BackgroundCuPercent\", SUM('Timepoint Background Detail'[% of Base Capacity])\n    ),\n    [InteractiveCuPercent] + [BackgroundCuPercent], DESC\n)"
            }
          ],
          "serializerSettings": {
            "includeNulls": true
          }
        }
