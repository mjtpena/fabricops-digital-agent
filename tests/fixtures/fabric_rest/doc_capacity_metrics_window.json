{
  "label": "doc_capacity_metrics_window",
  "description": "Built from the documented schema, not recorded live: a 30-minute window read through executeQueries. One capacity-level query, then the top items at the peak timepoint of the throttled bucket and of the busy bucket; the idle bucket gets no item query. The requests are the DAX the adapter generates (a change to it must be reviewed here); the table and measure names are assumptions listed in docs/spikes/capacity-metrics.md.",
  "entries": [
    {
      "request": {
        "method": "POST",
        "path": "/v1.0/myorg/groups/00000000-0000-4000-8000-0000000000a1/datasets/00000000-0000-4000-8000-0000000000a2/executeQueries",
        "query": {},
        "json": {
          "queries": [
            {
              "query": "EVALUATE\nTOPN(\n    21000,\n    SUMMARIZECOLUMNS(\n        'TimePoints'[TimePoint],\n        TREATAS({\"00000000-0000-4000-8000-0000000000a0\"}, 'Capacities'[capacityId]),\n        FILTER(ALL('TimePoints'[TimePoint]), 'TimePoints'[TimePoint] >= (DATE(2026, 10, 21) + TIME(12, 0, 0)) && 'TimePoints'[TimePoint] <= (DATE(2026, 10, 21) + TIME(12, 30, 0))),\n        \"CuPercent\", [CU %],\n        \"InteractiveDelayPercent\", [Interactive delay %],\n        \"BackgroundRejectionPercent\", [Background rejection %]\n    ),\n    'TimePoints'[TimePoint], DESC\n)\nORDER BY 'TimePoints'[TimePoint] ASC"
            }
          ],
          "serializerSettings": {
            "includeNulls": true
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json; charset=utf-8",
          "requestid": "00000000-0000-4000-8000-0000000000a6"
